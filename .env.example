NEXT_PUBLIC_LINKEDIN_URL="https://www.linkedin.com/company/softforge"
NEXT_PUBLIC_INSTAGRAM_URL="https://www.instagram.com/softforge"
NEXT_PUBLIC_GITHUB_URL="https://github.com/softforge"

# ------------------------------------------------------------------------------
# 3. Envio de Leads / E-mail & Integrações (Exclusivo Servidor — NUNCA exposto)
# ------------------------------------------------------------------------------
# Chave da API do Resend (https://resend.com). Se vazio, o lead é apenas logado no servidor.
RESEND_API_KEY="re_G7aYPfcY_7MWU4NB8rmbsxj3EcxN48Ki3"
RESEND_API_URL="https://api.resend.com/emails"

# Remetente verificado no Resend e destinatário dos orçamentos
CONTACT_FROM_EMAIL="SoftForge Site <onboarding@resend.dev>"
CONTACT_TO_EMAIL="contato@softforge.com.br"

# Webhook opcional (n8n, Discord, Slack, CRM) acionado a cada novo lead válido
CONTACT_WEBHOOK_URL=""

# ------------------------------------------------------------------------------
# 4. Segurança & Rate Limiting da API de Contato (/api/contact)
# ------------------------------------------------------------------------------
CONTACT_RATE_LIMIT_MAX="5"
CONTACT_RATE_LIMIT_WINDOW_MS="600000"
