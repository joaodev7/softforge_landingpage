NEXT_PUBLIC_COMPANY_LEGAL_NAME="SoftForge Tecnologia LTDA"
NEXT_PUBLIC_COMPANY_CNPJ="00.000.000/0001-00"
NEXT_PUBLIC_CITY="Ceará, CE"

# ------------------------------------------------------------------------------
# 2. Canais de Contato & Redes Sociais (Exibidos na Landing Page)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CONTACT_EMAIL="contato@softforge.com.br"
NEXT_PUBLIC_FOUNDER_NAME="João Vitor P. Andrade"
NEXT_PUBLIC_FOUNDER_EMAIL="joao@softforge.com.br"
NEXT_PUBLIC_PHONE_DISPLAY="+55 (85) 90000-0000"
# Somente dígitos com DDI (55) + DDD + número para o link wa.me
NEXT_PUBLIC_WHATSAPP_NUMBER="5585900000000"
